# Base URL of the KeyPass backend API.
#   HTTP  dev: http://localhost:5204
#   HTTPS dev: https://localhost:7044
VITE_API_BASE_URL=http://localhost:5204

# Optional. Only used by the production build for GitHub Pages, where the app is
# served from a sub-path. The deploy workflow sets this automatically.
# VITE_BASE_PATH=/keypass-manager/
